{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rapp:profile:rapp-federation-autobest:1",
  "title": "RAPP Federation AutoBest compatibility profile",
  "$ref": "#/$defs/frame",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "rappid": {
      "type": "string",
      "maxLength": 213,
      "pattern": "^rappid:@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$"
    },
    "memoryStream": {
      "type": "string",
      "maxLength": 278,
      "pattern": "^rappid:@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "signature": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]{86}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000-\\u001f\\u007f\\\\]+$"
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "seq",
        "payload_hash",
        "frame_hash"
      ],
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/memoryStream"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload_hash": {
          "$ref": "#/$defs/hash"
        },
        "frame_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "profilePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "spec_sha256",
        "schema_sha256",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "spec_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "external-binding",
            "pending"
          ]
        }
      }
    },
    "agentPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "sha256",
        "bytes",
        "status"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "source-lens",
            "target-finalizer",
            "generic-ceo",
            "locked-runtime"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "pending"
          ]
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space",
        "hash",
        "bytes"
      ],
      "properties": {
        "space": {
          "type": "string",
          "enum": [
            "rapp/1:particle",
            "rapp/1:wave",
            "rapp/1:egg-manifest",
            "sha256"
          ]
        },
        "hash": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "tier",
        "coverage_bps",
        "evidence"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/label"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "available-on-exhaust",
            "unavailable",
            "unproven"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "native-protocol",
            "declared-descriptor",
            "signed-stream-inference",
            "static-repository-compiler",
            "brainstem-translation-candidate"
          ]
        },
        "coverage_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    },
    "hotloadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "role",
        "agent_sha256",
        "request_sha256",
        "result_sha256",
        "policy_sha256",
        "model_calls",
        "network_calls",
        "executed_effects",
        "native_session_persisted",
        "brainstem_modified",
        "plugin_registered",
        "unloaded",
        "authority"
      ],
      "properties": {
        "schema": {
          "const": "rapp-federation-autobest/1/hotload-receipt"
        },
        "role": {
          "type": "string",
          "enum": [
            "source-lens",
            "target-finalizer",
            "locked-runtime"
          ]
        },
        "agent_sha256": {
          "$ref": "#/$defs/hash"
        },
        "request_sha256": {
          "$ref": "#/$defs/hash"
        },
        "result_sha256": {
          "$ref": "#/$defs/hash"
        },
        "policy_sha256": {
          "$ref": "#/$defs/hash"
        },
        "model_calls": {
          "const": 0
        },
        "network_calls": {
          "const": 0
        },
        "executed_effects": {
          "const": 0
        },
        "native_session_persisted": {
          "const": false
        },
        "brainstem_modified": {
          "const": false
        },
        "plugin_registered": {
          "const": false
        },
        "unloaded": {
          "const": true
        },
        "authority": {
          "const": false
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "required",
        "basis_points",
        "complete_for_read",
        "complete_for_membership",
        "unknowns"
      ],
      "properties": {
        "supported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "complete_for_read": {
          "type": "boolean"
        },
        "complete_for_membership": {
          "type": "boolean"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_frames",
        "max_files",
        "max_file_bytes",
        "max_total_bytes",
        "max_hotload_seconds",
        "max_lenses",
        "max_candidates",
        "max_cross_size",
        "max_depth",
        "max_rounds",
        "beam_width",
        "pareto_width",
        "model_calls_during_static_runtime"
      ],
      "properties": {
        "max_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "max_hotload_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_lenses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_cross_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pareto_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "model_calls_during_static_runtime": {
          "const": 0
        }
      }
    },
    "forwardMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "relation",
        "target_paths",
        "target_sha256",
        "trait",
        "loss_class"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "relation": {
          "type": "string",
          "enum": [
            "retained",
            "replaced",
            "moved",
            "removed"
          ]
        },
        "target_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "target_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "trait": {
          "$ref": "#/$defs/label"
        },
        "loss_class": {
          "type": "string",
          "enum": [
            "lossless-direct",
            "lossless-with-delta",
            "lossy-declared",
            "partial-unproven"
          ]
        }
      }
    },
    "reverseAncestry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successor_path",
        "successor_sha256",
        "class",
        "source_paths",
        "source_sha256",
        "inverse_available",
        "loss_class"
      ],
      "properties": {
        "successor_path": {
          "$ref": "#/$defs/relativePath"
        },
        "successor_sha256": {
          "$ref": "#/$defs/hash"
        },
        "class": {
          "type": "string",
          "enum": [
            "inherited",
            "derived",
            "new"
          ]
        },
        "source_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "source_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "inverse_available": {
          "type": "boolean"
        },
        "loss_class": {
          "type": "string",
          "enum": [
            "lossless-direct",
            "lossless-with-delta",
            "lossy-declared",
            "partial-unproven",
            "not-applicable"
          ]
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_parents",
        "forward",
        "reverse",
        "selected_traits",
        "omitted_traits",
        "ancestor_reconstruction",
        "roundtrip_claim"
      ],
      "properties": {
        "source_parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "forward": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forwardMutation"
          },
          "minItems": 1,
          "maxItems": 65536,
          "uniqueItems": true
        },
        "reverse": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reverseAncestry"
          },
          "minItems": 1,
          "maxItems": 65536,
          "uniqueItems": true
        },
        "selected_traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "omitted_traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "ancestor_reconstruction": {
          "type": "string",
          "enum": [
            "lossless",
            "lossy",
            "partial-unproven"
          ]
        },
        "roundtrip_claim": {
          "type": "boolean"
        }
      }
    },
    "bundleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "role",
        "regular_file"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "role": {
          "type": "string",
          "enum": [
            "handshake",
            "agent",
            "static-agent",
            "schema",
            "fixture",
            "candidate-test",
            "host-test",
            "documentation",
            "migration",
            "manifest",
            "receipt",
            "provenance"
          ]
        },
        "regular_file": {
          "const": true
        }
      }
    },
    "artifactBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "compatibility_frame",
        "entrypoint",
        "entries",
        "lineage",
        "candidate_tests_are_independent_proof",
        "host_tests_required",
        "canonical_tests_required",
        "controlled_mutants_required",
        "grants_authority"
      ],
      "properties": {
        "schema": {
          "const": "rapp-federation-autobest/1/artifact-bundle"
        },
        "compatibility_frame": {
          "$ref": "#/$defs/head"
        },
        "entrypoint": {
          "const": "static/agent.py"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bundleEntry"
          },
          "minItems": 1,
          "maxItems": 65536,
          "uniqueItems": true
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "candidate_tests_are_independent_proof": {
          "const": false
        },
        "host_tests_required": {
          "const": true
        },
        "canonical_tests_required": {
          "const": true
        },
        "controlled_mutants_required": {
          "const": true
        },
        "grants_authority": {
          "const": false
        }
      }
    },
    "learningEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "prev_event_hash",
        "event_hash",
        "type",
        "authority_class",
        "subject",
        "source_commitment",
        "references",
        "supersedes",
        "privacy_safe"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prev_event_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_hash": {
          "$ref": "#/$defs/hash"
        },
        "type": {
          "type": "string",
          "enum": [
            "intent",
            "assistant-proposal",
            "user-correction",
            "measured-result",
            "measured-failure",
            "assumption-superseded",
            "successor-invariant"
          ]
        },
        "authority_class": {
          "type": "string",
          "enum": [
            "user-authoritative",
            "host-policy",
            "assistant-proposal",
            "measured-evidence",
            "derived-invariant"
          ]
        },
        "subject": {
          "$ref": "#/$defs/label"
        },
        "source_commitment": {
          "$ref": "#/$defs/hash"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "privacy_safe": {
          "const": true
        }
      }
    },
    "learningTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "events",
        "correction_frontier_hash",
        "raw_transcript_persisted",
        "hidden_reasoning_persisted",
        "native_session_persisted"
      ],
      "properties": {
        "schema": {
          "const": "rapp-federation-autobest/1/learning-trace"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningEvent"
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "correction_frontier_hash": {
          "$ref": "#/$defs/hash"
        },
        "raw_transcript_persisted": {
          "const": false
        },
        "hidden_reasoning_persisted": {
          "const": false
        },
        "native_session_persisted": {
          "const": false
        }
      }
    },
    "lensSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ancestor",
        "use_case",
        "lens_pins",
        "max_lenses",
        "max_candidates",
        "max_cross_size",
        "max_depth",
        "max_rounds",
        "beam_width",
        "pareto_width",
        "root_budget_hash",
        "stop_reasons",
        "fitness_is_universal_truth"
      ],
      "properties": {
        "schema": {
          "const": "rapp-federation-autobest/1/lens-search"
        },
        "ancestor": {
          "$ref": "#/$defs/hash"
        },
        "use_case": {
          "$ref": "#/$defs/label"
        },
        "lens_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "max_lenses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_cross_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pareto_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "root_budget_hash": {
          "$ref": "#/$defs/hash"
        },
        "stop_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "scenario-threshold-met",
              "root-budget-exhausted",
              "no-progress",
              "repeated-frontier",
              "no-compatible-cross",
              "all-candidates-refused",
              "user-stop"
            ]
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "fitness_is_universal_truth": {
          "const": false
        }
      }
    },
    "mutationOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_parent",
        "successor_bundle",
        "lineage_hash",
        "compatibility_frame",
        "static_agent_sha256",
        "tests_hash",
        "transport",
        "grants_authority",
        "rewrites_ancestor",
        "activates_successor"
      ],
      "properties": {
        "schema": {
          "const": "rapp-federation-autobest/1/mutation-offer"
        },
        "source_parent": {
          "$ref": "#/$defs/hash"
        },
        "successor_bundle": {
          "$ref": "#/$defs/hash"
        },
        "lineage_hash": {
          "$ref": "#/$defs/hash"
        },
        "compatibility_frame": {
          "$ref": "#/$defs/hash"
        },
        "static_agent_sha256": {
          "$ref": "#/$defs/hash"
        },
        "tests_hash": {
          "$ref": "#/$defs/hash"
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator_hash",
            "base_commit",
            "head_commit"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "git-pr",
                "sealed-artifact",
                "local"
              ]
            },
            "locator_hash": {
              "$ref": "#/$defs/hash"
            },
