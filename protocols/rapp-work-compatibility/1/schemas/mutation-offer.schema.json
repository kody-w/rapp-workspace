{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/mutation-offer.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/mutation-offer"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "activation_mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "ancestor_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "successor_bundle": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "forward_map": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "reverse_map": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "tests": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "selected_traits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "omitted_traits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "transport": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "pull-request",
            "private-hive",
            "federation",
            "local"
          ]
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/particle"
        }
      },
      "required": [
        "kind",
        "base",
        "head",
        "evidence"
      ],
      "additionalProperties": false
    },
    "status": {
      "const": "candidate"
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "activation_mode",
    "activation",
    "restrictions",
    "ancestor_refs",
    "successor_bundle",
    "forward_map",
    "reverse_map",
    "compatibility",
    "tests",
    "selected_traits",
    "omitted_traits",
    "transport",
    "status",
    "grants_authority"
  ],
  "additionalProperties": false
}
