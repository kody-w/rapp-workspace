{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/compatibility-exhaust.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/compatibility-exhaust"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "activation_mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "active_compatibility": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "source_head": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "utc": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])"
        },
        "payload_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "frame_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "stream_id",
        "seq",
        "utc",
        "payload_hash",
        "frame_hash"
      ],
      "additionalProperties": false
    },
    "target_head": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "stream_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "utc": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])"
            },
            "payload_hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "frame_hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "stream_id",
            "seq",
            "utc",
            "payload_hash",
            "frame_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "direction": {
      "enum": [
        "source-to-target",
        "target-to-source"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
    },
    "locus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "missing_coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "loss_class": {
      "$ref": "common.schema.json#/$defs/loss_class"
    },
    "consumed": {
      "type": "object",
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_lenses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_cross_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "required": [
        "max_input_bytes",
        "max_output_bytes",
        "max_files",
        "max_frames",
        "max_lenses",
        "max_candidates",
        "max_cross_size",
        "max_depth",
        "max_rounds",
        "max_model_calls",
        "max_tool_calls"
      ],
      "additionalProperties": false
    },
    "retryable": {
      "type": "boolean"
    },
    "privacy_safe": {
      "const": true
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "activation_mode",
    "activation",
    "restrictions",
    "active_compatibility",
    "source_head",
    "target_head",
    "direction",
    "code",
    "locus",
    "missing_coverage",
    "loss_class",
    "consumed",
    "retryable",
    "privacy_safe",
    "grants_authority"
  ],
  "additionalProperties": false
}
