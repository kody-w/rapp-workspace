{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/promotion-decision.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/promotion-decision"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "activation_mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "proposal": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "decision": {
      "enum": [
        "adopted",
        "rejected",
        "canary",
        "rollback"
      ]
    },
    "authority_rappid": {
      "type": "string",
      "minLength": 76,
      "maxLength": 213,
      "pattern": "^rappid:@(?=[^/]{1,39}/)[a-z0-9]+(?:-[a-z0-9]+)*/(?=[^:]{1,100}:)[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "authority_evidence": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "previous_selection": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "new_selection": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "automatic": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "activation_mode",
    "activation",
    "restrictions",
    "proposal",
    "decision",
    "authority_rappid",
    "authority_evidence",
    "previous_selection",
    "new_selection",
    "automatic",
    "grants_authority"
  ],
  "additionalProperties": false
}
