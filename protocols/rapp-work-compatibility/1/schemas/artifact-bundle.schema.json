{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/artifact-bundle.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/artifact-bundle"
    },
    "egg_manifest": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "entrypoint": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "particle": {
          "type": "object",
          "properties": {
            "space": {
              "const": "rapp/1:particle"
            },
            "hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "space",
            "hash"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "executable": {
          "const": false
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "particle",
        "role",
        "media_type",
        "executable"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "particle": {
            "type": "object",
            "properties": {
              "space": {
                "const": "rapp/1:particle"
              },
              "hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "space",
              "hash"
            ],
            "additionalProperties": false
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
          },
          "executable": {
            "const": false
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "particle",
          "role",
          "media_type",
          "executable"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "generation_receipt": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "mutation_manifest": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "reverse_ancestry": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "producer_tests": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "host_tests": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "mutation_tests": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "particle": {
            "type": "object",
            "properties": {
              "space": {
                "const": "rapp/1:particle"
              },
              "hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "space",
              "hash"
            ],
            "additionalProperties": false
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
          },
          "executable": {
            "const": false
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "particle",
          "role",
          "media_type",
          "executable"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "egg_manifest",
    "entrypoint",
    "files",
    "compatibility",
    "generation_receipt",
    "mutation_manifest",
    "reverse_ancestry",
    "producer_tests",
    "host_tests",
    "mutation_tests",
    "migrations",
    "authority"
  ],
  "additionalProperties": false
}
