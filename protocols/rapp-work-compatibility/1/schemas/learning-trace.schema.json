{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/learning-trace.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/learning-trace"
    },
    "trigger": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "previous_event": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/particle"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "intent",
              "assistant-proposal",
              "user-correction",
              "measured-result",
              "superseded-assumption",
              "successor-invariant"
            ]
          },
          "actor_class": {
            "enum": [
              "user-authority",
              "owner-authority",
              "assistant-proposal",
              "tool-observation",
              "agent-observation",
              "host-policy"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/particle"
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          },
          "scope": {
            "$ref": "common.schema.json#/$defs/particle"
          },
          "structured_claim": {
            "$ref": "common.schema.json#/$defs/particle"
          },
          "authority_evidence": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/particle"
              },
              {
                "type": "null"
              }
            ]
          },
          "restrictions": {
            "type": "object",
            "properties": {
              "rights": {
                "type": "object",
                "properties": {
                  "capture": {
                    "type": "boolean"
                  },
                  "local_synthesis": {
                    "type": "boolean"
                  },
                  "model_submission": {
                    "type": "boolean"
                  },
                  "retention": {
                    "type": "boolean"
                  },
                  "redistribution": {
                    "type": "boolean"
                  },
                  "adoption": {
                    "type": "boolean"
                  },
                  "materialization": {
                    "type": "boolean"
                  },
                  "execution": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "capture",
                  "local_synthesis",
                  "model_submission",
                  "retention",
                  "redistribution",
                  "adoption",
                  "materialization",
                  "execution"
                ],
                "additionalProperties": false
              },
              "privacy": {
                "enum": [
                  "godd",
                  "dogg",
                  "neutral"
                ]
              },
              "audience": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
                },
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true
              },
              "hashes_sensitive": {
                "const": true
              },
              "repository_content_is_instructions": {
                "const": false
              },
              "grants_authority": {
                "const": false
              },
              "authorizes_effects": {
                "const": false
              }
            },
            "required": [
              "rights",
              "privacy",
              "audience",
              "hashes_sensitive",
              "repository_content_is_instructions",
              "grants_authority",
              "authorizes_effects"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "seq",
          "previous_event",
          "kind",
          "actor_class",
          "source_refs",
          "scope",
          "structured_claim",
          "authority_evidence",
          "restrictions"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "decision_frontier": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "receipt_frontier": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "unresolved": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "raw_transcript_persisted": {
      "const": false
    },
    "hidden_reasoning_persisted": {
      "const": false
    },
    "native_paths_persisted": {
      "const": false
    },
    "restrictions": {
      "type": "object",
      "properties": {
        "rights": {
          "type": "object",
          "properties": {
            "capture": {
              "type": "boolean"
            },
            "local_synthesis": {
              "type": "boolean"
            },
            "model_submission": {
              "type": "boolean"
            },
            "retention": {
              "type": "boolean"
            },
            "redistribution": {
              "type": "boolean"
            },
            "adoption": {
              "type": "boolean"
            },
            "materialization": {
              "type": "boolean"
            },
            "execution": {
              "type": "boolean"
            }
          },
          "required": [
            "capture",
            "local_synthesis",
            "model_submission",
            "retention",
            "redistribution",
            "adoption",
            "materialization",
            "execution"
          ],
          "additionalProperties": false
        },
        "privacy": {
          "enum": [
            "godd",
            "dogg",
            "neutral"
          ]
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "hashes_sensitive": {
          "const": true
        },
        "repository_content_is_instructions": {
          "const": false
        },
        "grants_authority": {
          "const": false
        },
        "authorizes_effects": {
          "const": false
        }
      },
      "required": [
        "rights",
        "privacy",
        "audience",
        "hashes_sensitive",
        "repository_content_is_instructions",
        "grants_authority",
        "authorizes_effects"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "trigger",
    "events",
    "decision_frontier",
    "receipt_frontier",
    "unresolved",
    "raw_transcript_persisted",
    "hidden_reasoning_persisted",
    "native_paths_persisted",
    "restrictions"
  ],
  "additionalProperties": false
}
