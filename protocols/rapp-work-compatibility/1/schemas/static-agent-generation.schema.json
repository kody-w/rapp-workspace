{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/static-agent-generation.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/static-agent-generation"
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "compatibility_payload_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "compiler": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "particle": {
          "type": "object",
          "properties": {
            "space": {
              "const": "rapp/1:particle"
            },
            "hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "space",
            "hash"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "executable": {
          "const": false
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "particle",
        "role",
        "media_type",
        "executable"
      ],
      "additionalProperties": false
    },
    "runtime_sha256": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "options": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "output": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "particle": {
          "type": "object",
          "properties": {
            "space": {
              "const": "rapp/1:particle"
            },
            "hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "space",
            "hash"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "executable": {
          "const": false
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "particle",
        "role",
        "media_type",
        "executable"
      ],
      "additionalProperties": false
    },
    "deterministic": {
      "const": true
    },
    "generated_tests_are_independent_proof": {
      "const": false
    },
    "tests": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "compatibility",
    "compatibility_payload_hash",
    "compiler",
    "runtime_sha256",
    "options",
    "output",
    "deterministic",
    "generated_tests_are_independent_proof",
    "tests",
    "grants_authority"
  ],
  "additionalProperties": false
}
