{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/raw/main/protocols/rapp-work-compatibility/1/schemas/evaluation-receipt.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-compatibility/1/evaluation-receipt"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "activation_mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "candidate": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "corpus": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "holdout": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "mutants": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "canary": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "verifier": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "particle": {
          "type": "object",
          "properties": {
            "space": {
              "const": "rapp/1:particle"
            },
            "hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "space",
            "hash"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
        },
        "executable": {
          "const": false
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "particle",
        "role",
        "media_type",
        "executable"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "scenarios_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scenarios_passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scenarios_failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdouts_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdouts_passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdouts_failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutants_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutants_killed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutants_survived": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prior_regressions_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prior_regressions_preserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prior_regressions_lost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage_gaps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "distinct_source_roots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "distinct_target_roots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "distinct_organization_roots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "privacy_violations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authority_violations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canary_successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canary_failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scenarios_total",
        "scenarios_passed",
        "scenarios_failed",
        "holdouts_total",
        "holdouts_passed",
        "holdouts_failed",
        "mutants_total",
        "mutants_killed",
        "mutants_survived",
        "prior_regressions_total",
        "prior_regressions_preserved",
        "prior_regressions_lost",
        "coverage_items",
        "coverage_gaps",
        "distinct_source_roots",
        "distinct_target_roots",
        "distinct_organization_roots",
        "privacy_violations",
        "authority_violations",
        "canary_successes",
        "canary_failures"
      ],
      "additionalProperties": false
    },
    "generated_tests_are_independent_proof": {
      "const": false
    },
    "passed": {
      "type": "boolean"
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "activation_mode",
    "activation",
    "restrictions",
    "candidate",
    "corpus",
    "holdout",
    "mutants",
    "canary",
    "verifier",
    "metrics",
    "generated_tests_are_independent_proof",
    "passed",
    "grants_authority"
  ],
  "additionalProperties": false
}
