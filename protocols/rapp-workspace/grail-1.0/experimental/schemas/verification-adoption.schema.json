{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/verification-adoption.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/verification-adoption"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "candidate": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "evidence": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "base": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorized_by": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "decision": {
      "enum": [
        "adopt",
        "reject"
      ]
    },
    "authority_scope": {
      "enum": [
        "local-explicit-consent",
        "rapp1-owner-policy"
      ]
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "candidate",
    "evidence",
    "base",
    "authorized_by",
    "decision",
    "authority_scope"
  ],
  "additionalProperties": false
}
