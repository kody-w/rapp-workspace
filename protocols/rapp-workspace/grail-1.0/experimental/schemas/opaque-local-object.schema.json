{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/opaque-local-object.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/opaque-local-object"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "root_name_b64": {
      "type": "string",
      "minLength": 0,
      "maxLength": 5464,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
    },
    "object_kind": {
      "enum": [
        "file",
        "directory",
        "symlink",
        "special"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path_b64": {
            "type": "string",
            "minLength": 0,
            "maxLength": 5464,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "file",
              "directory",
              "symlink",
              "special"
            ]
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "bytes": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "octets_b64": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 5464,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverage": {
            "enum": [
              "inline",
              "digest-only",
              "metadata-only"
            ]
          }
        },
        "required": [
          "path_b64",
          "kind",
          "mode",
          "bytes",
          "sha256",
          "octets_b64",
          "coverage"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "fingerprint": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "read_scope": {
      "const": "explicit-local-object"
    },
    "native_identity": {
      "type": "null"
    },
    "semantics": {
      "const": "unknown"
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "subject",
    "root_name_b64",
    "object_kind",
    "entries",
    "fingerprint",
    "read_scope",
    "native_identity",
    "semantics",
    "native_compliance"
  ],
  "additionalProperties": false
}
