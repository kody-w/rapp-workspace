{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/native-shape-observation.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/native-shape-observation"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "tile": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "shape": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "metadata": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/fact"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "fingerprint": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "source_state": {
      "const": "opaque"
    },
    "read_scope": {
      "const": "approved-metadata-only"
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "tile",
    "subject",
    "shape",
    "sources",
    "metadata",
    "fingerprint",
    "findings",
    "source_state",
    "read_scope",
    "native_compliance"
  ],
  "additionalProperties": false
}
