{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/registry-projection.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/registry-projection"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "adopted": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "heads": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/head"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame": {
            "$ref": "common.schema.json#/$defs/wave"
          },
          "selected": {
            "type": "boolean"
          },
          "suppressed": {
            "type": "boolean"
          },
          "eligible": {
            "type": "boolean"
          }
        },
        "required": [
          "frame",
          "selected",
          "suppressed",
          "eligible"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "migration": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "adopted",
    "heads",
    "entries",
    "migration",
    "authority"
  ],
  "additionalProperties": false
}
