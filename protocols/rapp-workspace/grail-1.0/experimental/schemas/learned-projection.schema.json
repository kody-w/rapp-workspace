{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/learned-projection.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/learned-projection"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/fact"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "tick",
    "facts",
    "native_compliance"
  ],
  "additionalProperties": false
}
