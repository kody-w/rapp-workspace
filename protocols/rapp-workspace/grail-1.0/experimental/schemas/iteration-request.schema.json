{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/iteration-request.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/iteration-request"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "loop": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "root": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "lens": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 33
    },
    "declared_reads": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "strategy": {
      "enum": [
        "select",
        "reapply",
        "descendant"
      ]
    },
    "lens_parent": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "work_key": {
      "$ref": "common.schema.json#/$defs/particle"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "loop",
    "root",
    "lens",
    "sources",
    "contexts",
    "parents",
    "depth",
    "declared_reads",
    "strategy",
    "lens_parent",
    "work_key"
  ],
  "additionalProperties": false
}
