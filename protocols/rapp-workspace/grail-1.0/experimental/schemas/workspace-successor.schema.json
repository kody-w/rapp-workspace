{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/workspace-successor.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/workspace-successor"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "observation": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_observation": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "feedback": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "path_b64": {
            "type": "string",
            "minLength": 0,
            "maxLength": 5464,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          }
        },
        "required": [
          "entry",
          "path_b64",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true
    },
    "admission_class": {
      "const": "verified-structural-container"
    },
    "adoption_eligible": {
      "const": true
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "source",
    "observation",
    "tick",
    "context",
    "context_observation",
    "feedback",
    "members",
    "admission_class",
    "adoption_eligible",
    "native_compliance"
  ],
  "additionalProperties": false
}
