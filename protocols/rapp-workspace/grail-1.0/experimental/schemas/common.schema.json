    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "rappid": {
      "type": "string",
      "minLength": 76,
      "maxLength": 212,
      "pattern": "^rappid:@(?=[^/]{1,39}/)[a-z0-9]+(?:-[a-z0-9]+)*/(?=[^:]{1,100}:)[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)(?:\\.{1,2}|[Cc][Oo][Nn](?:\\.[^/]*)?|[Pp][Rr][Nn](?:\\.[^/]*)?|[Aa][Uu][Xx](?:\\.[^/]*)?|[Nn][Uu][Ll](?:\\.[^/]*)?|[Cc][Oo][Mm][1-9](?:\\.[^/]*)?|[Ll][Pp][Tt][1-9](?:\\.[^/]*)?)(?:/|$))(?!.*[. ](?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$(?![\\s\\S])"
    },
    "atom": {
