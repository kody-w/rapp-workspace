{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1/schemas/subscription-proposal.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1/subscription-proposal"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "activation_mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "native_subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "assessment": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "target": {
      "const": "rapp-private-hive"
    },
    "selected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "withheld_private": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "withheld_excluded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "externally_approved_private": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "external_owner_approval_required": {
      "const": true
    },
    "publication_authorized": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "activation_mode",
    "activation",
    "native_subject",
    "restrictions",
    "assessment",
    "target",
    "selected_ids",
    "withheld_private",
    "withheld_excluded",
    "externally_approved_private",
    "external_owner_approval_required",
    "publication_authorized",
    "grants_authority"
  ],
  "additionalProperties": false
}
