{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1/schemas/activation-document.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1/activation-document"
    },
    "spec_id": {
      "const": "rapp-workspace/1"
    },
    "spec_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "runtime_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "instance_rappid": {
      "type": "string",
      "minLength": 76,
      "maxLength": 213,
      "pattern": "^rappid:@(?=[^/]{1,39}/)[a-z0-9]+(?:-[a-z0-9]+)*/(?=[^:]{1,100}:)[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "not_before_utc": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])"
    },
    "expires_utc": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])"
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "revocation_status": {
      "enum": [
        "active",
        "revoked"
      ]
    }
  },
  "required": [
    "schema",
    "spec_id",
    "spec_sha256",
    "runtime_sha256",
    "instance_rappid",
    "world_id",
    "not_before_utc",
    "expires_utc",
    "signer_key_id",
    "revocation_status"
  ],
  "additionalProperties": false
}
