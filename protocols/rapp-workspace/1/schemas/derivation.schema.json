{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1/schemas/derivation.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1/derivation"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "native_subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "lens": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "result_b64": {
      "type": "string",
      "minLength": 0,
      "maxLength": 87384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
    },
    "result_sha256": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "runtime_sha256": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "actual_reads": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/read"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "necessary_reads": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/read"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "synthesis_reads": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/read"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "negative_reads": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/read"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "enumerations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/read"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "environment": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/read"
      },
      "minItems": 0,
      "maxItems": 0,
      "uniqueItems": true
    },
    "portable": {
      "const": true
    },
    "native_rebinding": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "native_subject",
    "restrictions",
    "sources",
    "lens",
    "result_b64",
    "result_sha256",
    "runtime_sha256",
    "actual_reads",
    "necessary_reads",
    "synthesis_reads",
    "negative_reads",
    "enumerations",
    "environment",
    "portable",
    "native_rebinding"
  ],
  "additionalProperties": false
}
