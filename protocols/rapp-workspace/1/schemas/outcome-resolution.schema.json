{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1/schemas/outcome-resolution.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1/outcome-resolution"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "activation_mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "native_subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "assessment": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "query_sha256": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "selected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate",
        "unresolved"
      ]
    },
    "semantic_fidelity": {
      "const": "unproven"
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "activation_mode",
    "activation",
    "native_subject",
    "restrictions",
    "assessment",
    "query_sha256",
    "selected_ids",
    "status",
    "semantic_fidelity",
    "grants_authority"
  ],
  "additionalProperties": false
}
