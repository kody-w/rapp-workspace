{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1/schemas/observation.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1/observation"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "native_subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "content": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "octets_b64": {
      "type": "string",
      "minLength": 0,
      "maxLength": 87384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"
    },
    "octets_sha256": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "octets_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "subject_binding": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "consistency": {
      "enum": [
        "supplied-immutable-octets",
        "stable-descriptor-not-coherent"
      ]
    },
    "scope": {
      "const": "captured-octets-only"
    },
    "complete": {
      "type": "boolean"
    },
    "native_rebinding": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "native_subject",
    "restrictions",
    "content",
    "octets_b64",
    "octets_sha256",
    "octets_count",
    "subject_binding",
    "consistency",
    "scope",
    "complete",
    "native_rebinding"
  ],
  "additionalProperties": false
}
