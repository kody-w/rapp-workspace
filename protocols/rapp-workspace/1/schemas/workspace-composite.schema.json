{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1/schemas/workspace-composite.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1/workspace-composite"
    },
    "instance_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "native_subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "restrictions": {
      "$ref": "common.schema.json#/$defs/restrictions"
    },
    "assessment": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "composite_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "selected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "child_composites": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "member_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "members_sha256": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "recursive": {
      "const": true
    },
    "routing_only": {
      "const": true
    },
    "child_identities_preserved": {
      "const": true
    },
    "child_worlds_preserved": {
      "const": true
    },
    "content_copied": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "instance_rappid",
    "world_id",
    "native_subject",
    "restrictions",
    "assessment",
    "composite_id",
    "selected_ids",
    "child_composites",
    "member_count",
    "members_sha256",
    "depth",
    "recursive",
    "routing_only",
    "child_identities_preserved",
    "child_worlds_preserved",
    "content_copied",
    "grants_authority"
  ],
  "additionalProperties": false
}
