{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/derived-frame.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/derived-frame"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "lens": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "declared_reads": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "content": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "value_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 524288,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "lens",
    "declared_reads",
    "content",
    "value_json",
    "native_compliance"
  ],
  "additionalProperties": false
}
