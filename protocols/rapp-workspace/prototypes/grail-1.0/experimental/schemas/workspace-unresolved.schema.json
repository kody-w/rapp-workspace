{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/workspace-unresolved.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/workspace-unresolved"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "observation": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_observation": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "feedback": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "enum": [
        "incompatible-object-kind",
        "unresolved-links-or-special-members",
        "external-content-evidence-required",
        "insufficient-workspace-evidence",
        "context-source-contradiction",
        "source-not-bound-to-context",
        "unsupported-context-repair"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_sha256": {
            "$ref": "common.schema.json#/$defs/hash"
          },
          "context_sha256": {
            "$ref": "common.schema.json#/$defs/hash"
          }
        },
        "required": [
          "source_sha256",
          "context_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "retry_requirement": {
      "const": "additional-verified-workspace-context"
    },
    "adoption_eligible": {
      "const": false
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "source",
    "observation",
    "tick",
    "context",
    "context_observation",
    "feedback",
    "reason",
    "missing_fields",
    "contradictions",
    "retry_requirement",
    "adoption_eligible",
    "native_compliance"
  ],
  "additionalProperties": false
}
