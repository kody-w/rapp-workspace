{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/dimension-genesis.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/dimension-genesis"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "parent",
    "depth",
    "label"
  ],
  "additionalProperties": false
}
