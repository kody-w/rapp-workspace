{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-workspace/1.0/schemas/mutation-receipt.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-workspace/1.0/mutation-receipt"
    },
    "generation": {
      "const": "grail"
    },
    "estate_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$(?![\\s\\S])"
    },
    "seed": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "lens": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wave"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "declared_reads": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "successor": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "preservation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame": {
            "$ref": "common.schema.json#/$defs/wave"
          },
          "before_sha256": {
            "$ref": "common.schema.json#/$defs/hash"
          },
          "after_sha256": {
            "$ref": "common.schema.json#/$defs/hash"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        },
        "required": [
          "frame",
          "before_sha256",
          "after_sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "preservation_scope": {
      "const": "retained-frame-octets"
    },
    "native_compliance": {
      "const": "unclaimed"
    }
  },
  "required": [
    "schema",
    "generation",
    "estate_rappid",
    "world_id",
    "seed",
    "lens",
    "sources",
    "contexts",
    "declared_reads",
    "successor",
    "preservation",
    "preservation_scope",
    "native_compliance"
  ],
  "additionalProperties": false
}
