{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-work-organization/1/schemas/compatibility.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rapp-work-organization/1/compatibility"
    },
    "organization_rappid": {
      "$ref": "common.schema.json#/$defs/rappid"
    },
    "world_id": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "handshake_id": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_compatibility": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/wave"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "schema_sha256": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "inventory": {
          "$ref": "common.schema.json#/$defs/particle"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/wave"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "schema_sha256",
        "inventory",
        "parents"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "schema_sha256": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "inventory": {
          "$ref": "common.schema.json#/$defs/particle"
        }
      },
      "required": [
        "profile",
        "schema_sha256",
        "inventory"
      ],
      "additionalProperties": false
    },
    "lens": {
      "type": "object",
      "properties": {
        "source_agent": {
          "$ref": "common.schema.json#/$defs/artifactPin"
        },
        "target_finalizer": {
          "$ref": "common.schema.json#/$defs/artifactPin"
        },
        "receipts": {
          "$ref": "common.schema.json#/$defs/receiptSet"
        }
      },
      "required": [
        "source_agent",
        "target_finalizer",
        "receipts"
      ],
      "additionalProperties": false
    },
    "mapping_contract": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "forward_map": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "reverse_map": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "directionality": {
      "type": "string",
      "enum": [
        "bidirectional-lossless",
        "bidirectional-partial",
        "forward-only-lossy"
      ]
    },
    "policy": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "activation": {
      "$ref": "common.schema.json#/$defs/particle"
    },
    "trace": {
      "$ref": "common.schema.json#/$defs/wave"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "forward_bp": {
          "$ref": "common.schema.json#/$defs/basisPoints"
        },
        "reverse_bp": {
          "$ref": "common.schema.json#/$defs/basisPoints"
        },
        "source_roundtrip_bp": {
          "$ref": "common.schema.json#/$defs/basisPoints"
        },
        "target_roundtrip_bp": {
          "$ref": "common.schema.json#/$defs/basisPoints"
        },
        "declared_gaps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "unknowns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "forward_bp",
        "reverse_bp",
        "source_roundtrip_bp",
        "target_roundtrip_bp",
        "declared_gaps",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "bounds": {
      "$ref": "common.schema.json#/$defs/bounds"
    },
    "artifact_bundle": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/egg"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "locked-static-no-model"
        },
        "model_calls": {
          "const": 0
        },
        "typed_exhaust_on_gap": {
          "const": true
        }
      },
      "required": [
        "mode",
        "model_calls",
        "typed_exhaust_on_gap"
      ],
      "additionalProperties": false
    },
    "receipts": {
      "$ref": "common.schema.json#/$defs/receiptSet"
    },
    "grants_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "organization_rappid",
    "world_id",
    "handshake_id",
    "generation",
    "previous_compatibility",
    "source",
    "target",
    "lens",
    "mapping_contract",
    "forward_map",
    "reverse_map",
    "directionality",
    "policy",
    "activation",
    "trace",
    "coverage",
    "bounds",
    "artifact_bundle",
    "runtime",
    "receipts",
    "grants_authority"
  ],
  "additionalProperties": false
}
