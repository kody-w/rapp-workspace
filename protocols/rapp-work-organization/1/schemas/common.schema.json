{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-workspace/raw/main/protocols/rapp-work-organization/1/schemas/common.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$"
    },
    "rappid": {
      "type": "string",
      "minLength": 76,
      "maxLength": 213,
      "pattern": "^rappid:@(?=[^/]{1,39}/)[a-z0-9]+(?:-[a-z0-9]+)*/(?=[^:]{1,100}:)[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "wave": {
      "type": "object",
      "properties": {
        "space": {
          "const": "rapp/1:wave"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "space",
        "hash"
      ],
      "additionalProperties": false
    },
    "particle": {
      "type": "object",
      "properties": {
        "space": {
          "const": "rapp/1:particle"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "space",
        "hash"
      ],
      "additionalProperties": false
    },
    "egg": {
      "type": "object",
      "properties": {
        "space": {
          "const": "rapp/1:egg-manifest"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "space",
        "hash"
      ],
      "additionalProperties": false
    },
    "contentHead": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "100644",
            "100755"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "content": {
          "type": "object",
          "properties": {
            "space": {
              "const": "rapp/1:particle"
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "space",
            "hash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "entry_id",
        "path",
        "mode",
        "sha256",
        "bytes",
        "content"
      ],
      "additionalProperties": false
    },
    "receiptSet": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "space": {
            "const": "rapp/1:wave"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "space",
          "hash"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "artifactPin": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "embedded": {
          "type": "boolean"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "role",
        "embedded"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "lossless",
            "content-unavailable",
            "metadata-unavailable",
            "semantic-unavailable",
            "external-dependency-unavailable",
            "privacy-withheld",
            "noninvertible-transform"
          ]
        },
        "source_refs_preserved": {
          "type": "boolean"
        },
        "round_trip_claimed": {
          "type": "boolean"
        }
      },
      "required": [
        "class",
        "source_refs_preserved",
        "round_trip_claimed"
      ],
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "max_lenses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_cross_parents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_cross_traits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_work_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      },
      "required": [
        "max_lenses",
        "max_candidates",
        "max_cross_parents",
        "max_cross_traits",
        "max_depth",
        "max_rounds",
        "max_work_units",
        "max_artifact_bytes"
      ],
      "additionalProperties": false
    }
  }
}
